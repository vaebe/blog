generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Article {
  id         String    @id @unique
  userId     String?   @db.Uuid // = Profile.id (= neon_auth.user.id)；掘金同步文章无本地作者，可为空
  title      String
  content    String
  classify   String?
  coverImg   String?
  summary    String
  source     String? // 00 博客创建 01 掘金同步
  views      Int       @default(1)
  likes      Int       @default(1)
  favorites  Int       @default(1)
  showNumber Int       @default(1)
  status     String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt
  deletedAt  DateTime?
  isDeleted  Int?      @default(0)

  author Profile? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("article")
}

// =============================== 用户档案 ===============================
// 鉴权由 Neon Auth 接管，用户身份存于 neon_auth.user（不在 Prisma 管理范围）。
// profiles 是应用侧镜像：承载自定义 role，并作为 Article/Message 的外键目标。
// 由数据库触发器在 neon_auth.user 插入时自动同步（见 prisma/neon-auth-profiles-sync.sql）。
model Profile {
  id        String    @id @db.Uuid // = neon_auth.user.id
  role      String    @default("01") // 00 管理员 01 普通用户
  name      String?
  email     String?
  image     String?
  articles  Article[]
  messages  Message[]
  createdAt DateTime  @default(now())

  @@map("profiles")
}

// =============================== 留言板 ===============================
model Message {
  id        String    @id @default(cuid())
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // 删除时间

  author   Profile @relation(fields: [authorId], references: [id])
  authorId String  @db.Uuid

  @@index([authorId])
  @@map("message")
}

// =============================== 订阅 ===============================
model Subscriber {
  id        String    @id @default(cuid())
  email     String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // 删除时间

  @@map("subscriber")
}

// =============================== 缓存数据 ===============================
model CacheData {
  id        String    @id @default(cuid())
  key       String    @unique // 存储数据的 key
  data      String // 存储的数据 文本 或 json 字符串
  desc      String // 存储数据的描述
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // 删除时间

  @@map("cache-data")
}
