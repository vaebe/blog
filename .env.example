# 站点
NEXT_PUBLIC_SITE_URL=""

# Neon Postgres 数据库连接
# 运行时连接（连接池 / pooled），供 @prisma/adapter-neon 使用
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"
# 直连（unpooled），供 Prisma CLI 迁移 / db push 使用
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require"

# 掘金 userid
JUEJIN_USER_ID=""

# Neon Auth（鉴权）
# 在 Neon 控制台开通 Neon Auth 后获取；Google OAuth 与邮件发送均在控制台配置
NEON_AUTH_BASE_URL="https://<endpoint>.neonauth.<region>.aws.neon.tech/<db>/auth"
# 会话 cookie 签名密钥，至少 32 字符：openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""

# github（仓库/贡献等 API，与登录无关）
NEXT_PUBLIC_GITHUB_USER_NAME=""
GITHUB_API_TOKEN=""

# github repository
GITHUB_REPOSITORY_API_KEY=""

# 订阅/通知邮件发送（nodemailer SMTP，与登录无关）
EMAIL_SERVER_USER="xxxxx@qq.com"
EMAIL_SERVER_PASSWORD=""
EMAIL_SERVER_HOST="smtp.qq.com"
EMAIL_SERVER_PORT="465"
EMAIL_FROM="vaebe <xxxx@qq.com>"

# imagekit 图片存储服务
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=""
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=""
IMAGEKIT_PRIVATE_KEY=""